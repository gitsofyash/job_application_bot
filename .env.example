# Job Application Bot Configuration

# LLM Configuration
# Options: OLLAMA (default), GEMINI, OPENAI, ANTHROPIC, COHERE
LLM_PROVIDER=GEMINI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
RESUME_TAILOR_USE_LLM=false
RESUME_TAILOR_LLM_TIMEOUT_SECONDS=45
COVER_LETTER_USE_LLM=true
COVER_LETTER_MAX_CHARS=2400
COVER_LETTER_LLM_TIMEOUT_SECONDS=35
COVER_LETTER_LLM_MAX_WORDS=650
COVER_LETTER_LLM_MAX_TOKENS=650

# Browser Configuration
HEADLESS=true
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
TIMEOUT_MS=30000
WAIT_NETWORK_IDLE_TIMEOUT=10000

# Application Configuration
DRY_RUN=false
DEBUG=false
LOG_LEVEL=INFO

# Playwright Browser
BROWSER_TYPE=chromium
# Options: chromium, firefox, webkit
