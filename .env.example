# Job Application Bot - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Runtime
PYTHONDONTWRITEBYTECODE=1
DEBUG=false
LOG_LEVEL=INFO
DRY_RUN=false

# LLM provider used for resume tailoring when RESUME_TAILOR_USE_LLM=true.
# Supported values in the main tailoring pipeline: COHERE, OLLAMA, OPENAI, ANTHROPIC.
LLM_PROVIDER=COHERE

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus

# Optional Gemini polish pipeline
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_POLISH=false
GEMINI_POLISH_MIN_SCORE=90
GEMINI_POLISH_TIMEOUT_SECONDS=25

# Resume tailoring
RESUME_TAILOR_USE_LLM=false
RESUME_TAILOR_LLM_TIMEOUT_SECONDS=45
JD_MAX_WORDS=1000

# Cover letters
COVER_LETTER_USE_LLM=false
COVER_LETTER_MAX_CHARS=2400
COVER_LETTER_LLM_TIMEOUT_SECONDS=35
COVER_LETTER_LLM_MAX_WORDS=650
COVER_LETTER_LLM_MAX_TOKENS=650

# ATS score policy
ATS_MIN_SCORE=90
ATS_TARGET_SCORE=97
ATS_MAX_IMPROVEMENT_PASSES=5

# Browser extraction
HEADLESS=true
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
TIMEOUT_MS=30000
WAIT_NETWORK_IDLE_TIMEOUT=10000
BROWSER_TYPE=chromium
