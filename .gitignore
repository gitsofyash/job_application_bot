# ════════════════════════════════════════════════════════════════

*.db
*.sqlite
*.sqlite3
*.sql

# ════════════════════════════════════════════════════════════════
# THIRD-PARTY & DEPENDENCY FILES
# ════════════════════════════════════════════════════════════════

# Don't commit lock files (use requirements.txt instead)
Pipfile.lock
poetry.lock

# ════════════════════════════════════════════════════════════════
# MISC
# ════════════════════════════════════════════════════════════════

# macOS Finder
.DS_Store
.AppleDouble
.LSOverride

# Project-specific
*.bak
*.backup
*.old
*~
.swp

# Node modules (if any frontend tools used)
node_modules/
npm-debug.log

# ════════════════════════════════════════════════════════════════
# IMPORTANT: FILES TO KEEP
# ════════════════════════════════════════════════════════════════

# Keep these even if they match above patterns
!.gitignore
!.gitattributes
!.env.example
!extra/docs/*.md
!README.md
!requirements.txt
!main.py
!config/
!modules/
!templates/
!utils/
!data/
extra/docs/SETUP_AND_SHARING.md
